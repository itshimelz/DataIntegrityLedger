# Supabase PostgreSQL + Auth (https://supabase.com/dashboard/project/_/settings/api)
DATABASE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# RSA-2048 signing keys — generate with `bun run scripts/generate-keys.ts`; never commit real values
LEDGER_SIGNING_KEY=
LEDGER_PUBLIC_KEY=

# Optional demo configuration (SRS §21) — enables POST /api/demo/tamper; keep false outside local demo
ENABLE_TAMPER_DEMO=false
